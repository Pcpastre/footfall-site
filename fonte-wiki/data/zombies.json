  "pick_rules": "static ZClass pick(String key, Iterable<String> nearPlaces) {\n    if (key.isEmpty || key.startsWith('m|')) return ZClass.comum; // o zumbi da pilha e um jogador\n    final r = _u(key, 'c');\n    if (key.startsWith('h|')) {\n      // Horda: vem gente de toda parte; os militares que tentaram conter vem junto.\n      if (r < hordeMilitar) return ZClass.militar;\n      return r < hordeMilitar + streetChance ? _weighted(_u(key, 'w')) : ZClass.comum;\n    }\n    final local = [for (final p in nearPlaces) ...?byPlace[p]];\n    if (local.isNotEmpty && r < nearChance) return local[(_u(key, 'l') * local.length).floor() % local.length];\n    if (r > 1 - streetChance) return _weighted(_u(key, 'w'));\n    return ZClass.comum;\n  }",
